{
  "name": "Ferry — Secure File Sharing Between Your Devices",
  "short_name": "Ferry",
  "description": "Send passwords, text and files straight between your devices, end-to-end encrypted. No account, no uploads, nothing stored.",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "security"
  ],
  "id": "/",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
