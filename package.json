{
  "name": "ferry",
  "version": "1.0.0",
  "private": true,
  "description": "Hand passwords, text and files between your devices. End-to-end encrypted, peer-to-peer, nothing stored.",
  "scripts": {
    "dev": "next dev",
    "dev:relay": "node server/relay.js",
    "build": "next build",
    "postbuild": "node scripts/postbuild.js",
    "lan": "npm run build && node server/lan.js",
    "relay": "node server/relay.js",
    "start": "node server/relay.js",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test test/crypto.test.mjs test/lan.test.js test/relay.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/ws": "8.5.13",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsqr": "1.4.0",
    "next": "16.3.4",
    "postcss": "8.5.26",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
